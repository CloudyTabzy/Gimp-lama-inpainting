# Build artifacts
lama-inpainting-py/__pycache__/
lama-inpainting-py/**/__pycache__/
lama-worker-rs/target/

# Python
*.pyc
*.pyo

# Logs and temp
lama-inpainting-py/lama.log

# User-specific config (auto-rewritten by install.bat with the
# installer's resolved Python path; the deployed copy at
# %APPDATA%\GIMP\3.2\plug-ins\lama-inpaint\lama_config.json is the
# one the plug-in actually reads, the source copy is a staging area).
lama-inpainting-py/lama_config.json

# Large binary files (model)
# The LaMa model is fetched by install.bat from HuggingFace. Users
# running install.bat get it transparently; users running the plug-in
# from a clone get an explicit "download from <URL>" instruction
# printed on first use.
lama-inpainting-py/lama_fp32.onnx

# Manga model — too large for git, download from Releases or HuggingFace.
models/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Note: lama-worker-rs/Cargo.lock IS committed (this is a binary
# crate, we want reproducible builds). The target/ directory is
# ignored (build artifacts).

# Test output directory (generated by test runs)
tests/outputs/
